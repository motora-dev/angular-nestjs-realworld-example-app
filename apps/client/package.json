{
  "name": "@monorepo/client",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "clean": "rimraf .angular .turbo coverage dist locale node_modules",
    "clean:cache": "rimraf .angular .turbo coverage dist locale",
    "i18n:extract": "ng extract-i18n --output-path locale",
    "i18n:merge": "tsx scripts/merge-translations.ts",
    "i18n": "pnpm i18n:extract && pnpm i18n:merge",
    "build": "ng build --configuration=${BUILD_CONFIGURATION:-develop}",
    "start": "ng serve",
    "start:ssr": "node dist/client/server/server.mjs",
    "check-all": "pnpm lint && pnpm format && pnpm build && pnpm tsc && pnpm test",
    "format": "prettier --check \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.{ts,html}\" --config eslint.config.mjs --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "tsc": "pnpm tsc:build && pnpm tsc:test",
    "tsc:build": "tsc --noEmit --project tsconfig.build.json",
    "tsc:test": "tsc --noEmit --project tsconfig.spec.json",
    "test": "ng test --watch=false",
    "test:unit": "ng test --configuration=unit --watch=false",
    "test:e2e": "ng test --configuration=e2e --watch=false",
    "test:coverage": "ng test --coverage --configuration=unit --watch=false",
    "test:watch": "vitest",
    "storybook": "ng run client:storybook",
    "build-storybook": "ng run client:build-storybook"
  },
  "dependencies": {
    "@angular/animations": "catalog:",
    "@angular/cdk": "catalog:",
    "@angular/common": "catalog:",
    "@angular/compiler": "catalog:",
    "@angular/core": "catalog:",
    "@angular/forms": "catalog:",
    "@angular/platform-browser": "catalog:",
    "@angular/platform-browser-dynamic": "catalog:",
    "@angular/platform-server": "catalog:",
    "@angular/router": "catalog:",
    "@angular/ssr": "catalog:",
    "@ngxs/form-plugin": "catalog:",
    "@ngxs/store": "catalog:",
    "accept-language": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "compression": "catalog:",
    "dotenv": "catalog:",
    "express": "catalog:",
    "express-basic-auth": "catalog:",
    "marked": "catalog:",
    "rxjs": "catalog:",
    "tailwind-merge": "catalog:",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "catalog:",
    "@angular-eslint/eslint-plugin-template": "catalog:",
    "@angular-eslint/schematics": "catalog:",
    "@angular-eslint/template-parser": "catalog:",
    "@angular/build": "catalog:",
    "@angular/cli": "catalog:",
    "@angular/compiler-cli": "catalog:",
    "@angular/localize": "catalog:",
    "@monorepo/error-code": "workspace:*",
    "@monorepo/eslint-config": "workspace:*",
    "@monorepo/typescript-config": "workspace:*",
    "@storybook/angular": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@testing-library/angular": "catalog:",
    "@types/compression": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "postcss": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "storybook": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
